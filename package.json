{
  "name": "scvalfh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:scope": "node scripts/typecheck-scope.mjs",
    "test": "vitest run",
    "fetch-data": "tsx scripts/fetch-data.ts",
    "fetch-rosters": "tsx scripts/fetch-rosters.ts",
    "fetch-player-stats": "tsx scripts/fetch-player-stats.ts",
    "fetch-jv": "tsx scripts/fetch-jv.ts",
    "fetch-prior-season": "tsx scripts/fetch-prior-season.ts",
    "fetch-prior-players": "tsx scripts/fetch-prior-players.ts",
    "build-players": "tsx scripts/build-players.ts",
    "fetch-mascots": "tsx scripts/fetch-mascots.ts",
    "discover-season": "tsx scripts/discover-season.ts",
    "build-history": "tsx scripts/build-history.ts",
    "build-official-fixtures": "tsx scripts/build-official-fixtures.ts",
    "build-scval-basketball-fixtures": "tsx scripts/build-scval-basketball-fixtures.ts",
    "build-scval-volleyball-fixtures": "tsx scripts/build-scval-volleyball-fixtures.ts",
    "build-bval-winter-fixtures": "tsx scripts/build-bval-winter-fixtures.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vinext start",
    "build:cloudflare": "vite build --mode cloudflare",
    "preview:cloudflare": "vite preview --mode cloudflare",
    "deploy:cloudflare": "vinext-cloudflare deploy --env cloudflare",
    "assert:prerender": "tsx scripts/assert-prerender.ts",
    "assert:budgets": "tsx scripts/assert-budgets.ts",
    "assert:copy": "tsx scripts/assert-copy.ts",
    "assert:vinext": "tsx scripts/assert-vinext-prerender.ts",
    "gate:d": "bash scripts/stage-gate-d.sh"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.3.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "1.0.0-beta.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module"
}
